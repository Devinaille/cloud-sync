# cloud-sync environment template.
#
# Used two ways:
#   - docker-compose.env.yml reads this as env_file (copy to .env first)
#   - values here may also be set in the shell / a .env for variable substitution
#     (PUID/PGID/TZ/CLOUD_SYNC_TAG) in every compose variant
#
# Prefer config/cloud-sync.yaml (docker-compose.yml, config-file mode) for new
# deploys — a config file overrides these env values for any key it sets.
# In .env / inline modes, do NOT also create config/cloud-sync.yaml.

# --- runtime (used by compose, not the app) ---
# Container user. Defaults to the image's nonroot (65532). Set to the host
# owner of the media dirs so cleanup/watch can write.
PUID=1000
PGID=1000
TZ=Asia/Shanghai
# Image version to run (git tag); "latest" is published by full releases only.
# CLOUD_SYNC_TAG=v0.1.0

# --- app config ---
# OpenList
OPENLIST_URL=http://openlist:5244
OPENLIST_TOKEN=replace-me
# Storage ROOTS; cloud-sync appends a "media" subdir on upload.
OPENLIST_SRC_STORAGE=/local_media
OPENLIST_DST_STORAGE=/139yun_media
# false → skip_existing (keep cloud file if present); true → overwrite
OPENLIST_OVERWRITE=false

# Watched local directories (comma-separated absolute paths; fsnotify recurses each)
WATCH_DIRS=/mnt/basic/media/media,/mnt/basic/media/ani-rss

# Sync state. Defaults to /config/.sync_status when unset; /config is the
# mounted config directory, so state persists with the config.
SYNC_STATUS_DIR=/config/.sync_status

# Cleanup
CLEANUP_AFTER_HOURS=72
CLEANUP_DRY_RUN=true

# Upload pipeline
UPLOAD_CONCURRENCY=2
STABILIZE_WAIT_SECONDS=30
POLL_INTERVAL_SECONDS=3
TASK_TIMEOUT_SECONDS=1800

# Safety: cleanup refuses to delete outside these prefixes (include every WATCH_DIRS entry)
ALLOWED_SOURCE_PREFIXES=/mnt/basic/media/media,/mnt/basic/media/ani-rss

# Web UI + JSON API (default :8099; empty or "-" disables)
UI_LISTEN=:8099

# Task switch (default false: nothing runs until enabled via the UI or here)
TASKS_ENABLED=false

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/cloud-sync/cloud-sync.log
